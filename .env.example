# ─────────────────────────────────────────────────────────────
# AIHAA environment variables — copy to .env.local and fill in.
# .env.local is gitignored; this .example file is the tracked template.
# ─────────────────────────────────────────────────────────────

# OpenAI API — chatbot (/api/chat)
# Create at platform.openai.com → API keys. Set a monthly budget cap.
OPENAI_API_KEY=sk-...

# Vercel KV (Redis) — sales rotation counter (/api/sales-rotation)
# NOTE: KV is now provisioned via the Vercel Marketplace (Upstash),
# not the old Storage → KV tab. Provisioning auto-injects these vars
# into the project; pull them locally with `npx vercel env pull .env.local`.
# The @vercel/kv client reads KV_REST_API_URL + KV_REST_API_TOKEN.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
